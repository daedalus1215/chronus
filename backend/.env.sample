# Database Configuration
DATABASE=db.sqlite

# JWT Authentication
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRES_IN=7d
COOKIE_KEY=your-cookie-key-here-change-in-production

# Environment
NODE_ENV=development

# Security (optional)
# Set to false to disable public registration (recommended for production single-user apps)
ALLOW_REGISTRATION=true
# Comma-separated list of allowed CORS origins (omit to allow all origins, e.g. in development)
# FRONTEND_ORIGIN=https://your-domain.com,https://www.your-domain.com

# Server Configuration (optional)
PORT=3000
# Max request body size for JSON/urlencoded (default: 10mb). Use bytes or units like 10mb, 512kb.
# BODY_LIMIT=10mb

# Hermes API (for text-to-speech)
HERMES_API_URL=http://localhost:8000

# Thoth transcription service (private network only — never exposed to clients).
# The browser reaches this only through /api/notes/transcribe-audio; thoth's port
# must be firewalled to this backend's host. See specs/transcription-gateway.md.
THOTH_WS_URL=wss://localhost:8443
# PEM path for thoth's self-signed certificate. Required when THOTH_WS_URL is wss://.
# Do NOT work around a missing cert with rejectUnauthorized: false.
# THOTH_CA_CERT=/absolute/path/to/thoth-ca.crt
# Hard cap on a single transcription session (ms). Default 30 minutes.
TRANSCRIPTION_MAX_SESSION_MS=1800000
# Live transcription sessions per user. Thoth is single-session per process —
# see specs/transcription-gateway.md §3 before raising this.
TRANSCRIPTION_MAX_SESSIONS_PER_USER=1

# SMTP Configuration (for email reminders)
# Gmail example:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# SSL Configuration (optional)
# SSL_KEYFILE=/path/to/server.key
# SSL_CERTFILE=/path/to/server.crt
